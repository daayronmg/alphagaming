# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.
DATABASE_URL=postgres://estrella:estrella_dev@localhost:5432/estrella
PORT=4000
# Origen público de la app (para enlaces de recuperación y cookies seguras)
PUBLIC_URL=http://localhost:5173
# Carpeta privada de archivos (partituras, audios). No debe servirse públicamente.
STORAGE_DIR=./storage
# Límite de subida en MB
MAX_UPLOAD_MB=60
# Opcional: asistente con IA (si falta, el asistente funciona solo con respuestas verificables locales)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Opcional: reconocimiento óptico de música (ruta al ejecutable de Audiveris)
AUDIVERIS_PATH=
# Opcional: correo para recuperación de contraseña (smtp://usuario:clave@host:587)
SMTP_URL=
MAIL_FROM=ESTRELLA <no-responder@example.com>
